@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Product',
                  typeNamePlural: 'Products',
                  title: { type: #STANDARD, value: 'ProductName' } }
annotate entity ZC_SH2_PRODUCT with
{
  @UI.facet: [{ id: 'Product',
                purpose: #STANDARD,
                type: #IDENTIFICATION_REFERENCE,
                label: 'Product',
                position: 10 }]
  @UI.lineItem:       [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  ProductId;

  @UI.lineItem:       [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  ProductName;

  @UI.lineItem:       [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  Price;

  @UI.identification: [{ position: 40 }]
  Currency;

  @UI.lineItem:       [{ position: 40, criticality: 'StockCriticality' }]
  @UI.identification: [{ position: 50, criticality: 'StockCriticality' }]
  Stock;

  @UI.hidden: true
  StockCriticality; 
  
}