managed implementation in class zbp_r_sh2_product unique;

define behavior for ZR_SH2_PRODUCT alias Product
persistent table zsh2_product
lock master
{
  create;
  update;
  delete;

  field ( readonly : update ) ProductId;

validation validatePrice on save { create; field Price; }
validation validateStock on save { create; field Stock; }

  mapping for zsh2_product
    {
      ProductId   = product_id;
      ProductName = name;
      Price       = price;
      Currency    = currency;
      Stock       = stock;
    }
}